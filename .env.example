# ==============================================================================
# ExamSathi AI — Environment Variables Template
# Copy this file to .env (or .env.local) and replace with your real API credentials.
# NEVER commit your real .env file or API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Public / Browser-Safe)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon / Publishable Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# ------------------------------------------------------------------------------
# 2. Server-Side AI LLM Providers (Server-Only / DO NOT PREFIX WITH VITE_)
# ------------------------------------------------------------------------------
# Google AI Studio Gemini API Key (for Grounded Search & Embeddings)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GroqCloud API Key (for Ultra-Fast LPU Academic Study Buddy)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Target Model (e.g., qwen/qwen3.8-27b, openai/gpt-oss-120b)
GROQ_MODEL=qwen/qwen3.8-27b

# (Optional) Google Gemini Model Override (defaults to gemini-3.5-flash-lite)
# GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 3. Tesseract OCR (Optional Custom Binary Path on Windows)
# ------------------------------------------------------------------------------
# If Tesseract is not in your system PATH, specify its location here:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

